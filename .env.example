# ── AI News Agent Configuration ──────────────────────────────────────────────
# Copy this to .env and fill in your values.
# NEVER commit your .env file to version control.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Ollama Cloud is the PRIMARY provider (subscription-based, no per-token cost).
# Supports any OpenAI-compatible endpoint.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/api/chat
LLM_API_KEY=your_ollama_api_key_here

# Fallback provider (used if Ollama is unavailable)
FALLBACK_PROVIDER=openrouter
FALLBACK_BASE_URL=https://openrouter.ai/api/v1/chat/completions
FALLBACK_API_KEY=your_openrouter_key_here

# ── Model Selection ───────────────────────────────────────────────────────────
# Classification/filtering model (fast, tool-capable)
MODEL_CLASSIFY=minimax-m2.7:cloud
# Summarization model (consistent quality)
MODEL_SUMMARIZE=minimax-m2.7:cloud
# Synthesis model (long-form output, high quality)
MODEL_SYNTHESIS=glm-5.1:cloud

# ── Telegram Delivery ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── TTS Configuration ────────────────────────────────────────────────────────
# Edge-TTS voice (Microsoft voices, free)
TTS_VOICE=en-GB-RyanNeural
# Alternative: en-US-GuyNeural, en-AU-WilliamNeural, en-IN-PrateekNeural

# ── Pipeline Settings ─────────────────────────────────────────────────────────
# Maximum articles to deep-read per run
MAX_DEEP_READ=30
# Maximum stories in the final briefing
MAX_NOTEWORTHY=50
# Maximum HIGH-priority articles before capping
HIGH_CAP=20
# Deduplication: hours to remember seen headlines
DEDUP_HOURS=12
# Fuzzy dedup threshold (0.0-1.0, higher = stricter)
DEDUP_THRESHOLD=0.6
# Quiet hours (24h format, local time). Pipeline skips during these hours.
QUIET_HOUR_START=22
QUIET_HOUR_END=6

# ── Paths ─────────────────────────────────────────────────────────────────────
# Base directory for database, logs, and output
BASE_DIR=~/.ai-news-agent